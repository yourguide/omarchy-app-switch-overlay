    { "key": "fist", "label": "Slam fist", "type": "bool", "default": true },
    { "key": "cracksBuildUp", "label": "Cracks build up", "type": "bool", "default": true },
    { "key": "punchThrough", "label": "Punch-through fist", "type": "bool", "default": true }
